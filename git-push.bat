@echo off
cd /d "%~dp0"
echo [1/5] Initializing Git repository...
git init
echo [2/5] Setting up remote origin...
git remote remove origin >nul 2>&1
git remote add origin https://github.com/aryansri-coc/filecon.git
echo [3/5] Setting branch to main...
git branch -M main
echo [4/5] Staging files...
git add .
echo [5/5] Committing changes...
git commit -m "Initial commit: CorelFlow Studio - All-in-One PDF, CDR & Image Media Suite"
echo.
echo Pushing to GitHub (https://github.com/aryansri-coc/filecon)...
git push -u origin main
